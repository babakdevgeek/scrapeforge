# ---- backend ----
PORT=3000
# Prisma app database (scrapers, runs, logs, records)
DATABASE_URL="file:./prisma/scrapeforge.db"

# Destination store for scraped rows (auto-created tables)
# sqlite | postgres
DATA_STORE_DRIVER=sqlite
DATA_STORE_SQLITE_PATH=./data/scraped.db
# Only used when DATA_STORE_DRIVER=postgres
DATA_STORE_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/scrapeforge

# Browser engine
PLAYWRIGHT_HEADLESS=true
DEFAULT_TIMEOUT_MS=30000

# ---- frontend ----
VITE_API_URL=http://localhost:3000
